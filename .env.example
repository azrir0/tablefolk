# Optional: Connect to Supabase Postgres or Docker Postgres.
# Leave unset for zero-setup embedded local PostgreSQL (PGlite).
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tablefolk

# Optional: Drop in Supabase Auth JWT secret to accept Supabase JWTs directly.
# SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Local dev JWT secret (replace in production)
TABLEFOLK_JWT_SECRET=tablefolk-local-dev-jwt-secret-change-me

# Game Server Port & Allowed Browser Origin(s) (comma-separated in production)
PORT=2567
# WEB_ORIGIN=https://your-tablefolk-site.vercel.app

# Web client server URLs
NEXT_PUBLIC_API_URL=http://localhost:2567
NEXT_PUBLIC_WS_URL=ws://localhost:2567

# Production Docker image for @tablefolk/game-server (Colyseus + Express + Drizzle)
# Compatible with Railway, Render, and Fly.io
FROM node:22-slim

WORKDIR /app

# Install pnpm matching workspace packageManager
RUN npm install -g pnpm@12.23.0

# Copy ALL workspace manifests & lockfile so pnpm workspace resolution succeeds cleanly
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml tsconfig.base.json ./
COPY apps/game-server/package.json apps/game-server/
COPY apps/web/package.json apps/web/
COPY packages/shared/package.json packages/shared/
COPY packages/db/package.json packages/db/
COPY packages/game-engine/package.json packages/game-engine/
COPY packages/games/hearthvale/package.json packages/games/hearthvale/
COPY packages/games/treasure-trails/package.json packages/games/treasure-trails/
COPY packages/cafe-engine/package.json packages/cafe-engine/
COPY packages/ui/package.json packages/ui/

# Install only the game-server dependency subgraph (before setting NODE_ENV=production)
RUN pnpm install --frozen-lockfile --filter @tablefolk/game-server...

# Copy server & required workspace source code
COPY apps/game-server apps/game-server
COPY packages/shared packages/shared
COPY packages/db packages/db
COPY packages/game-engine packages/game-engine
COPY packages/games/hearthvale packages/games/hearthvale
COPY packages/games/treasure-trails packages/games/treasure-trails

ENV NODE_ENV=production
EXPOSE 2567

CMD ["pnpm", "--filter", "@tablefolk/game-server", "start"]

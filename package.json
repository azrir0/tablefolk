{
  "name": "tablefolk",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter @tablefolk/web dev",
    "dev:server": "pnpm --filter @tablefolk/game-server dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:seed": "pnpm --filter @tablefolk/db seed"
  },
  "devDependencies": {
    "turbo": "^2.4.4",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
